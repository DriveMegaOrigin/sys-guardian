[Unit]
Description=Sys-Guardian - Real-Time Hardware & System Integrity Daemon
Documentation=https://github.com/DriveMegaOrigin/sys-guardian
After=multi-user.target
Wants=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sys-guardian daemon
Restart=always
RestartSec=5
KillMode=mixed

# Systemd directory management
RuntimeDirectory=sys-guardian
RuntimeDirectoryMode=0755
LogsDirectory=sys-guardian
LogsDirectoryMode=0755

# Sandboxing and Resource Limits
MemoryMax=32M
CPUQuota=10%

[Install]
WantedBy=multi-user.target
