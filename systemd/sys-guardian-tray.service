[Unit]
Description=Sys-Guardian System Tray Status Indicator
Documentation=https://github.com/
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sys-guardian-tray
Restart=on-failure
RestartSec=5

# Memory and CPU limit
MemoryMax=32M
CPUQuota=5%

[Install]
WantedBy=graphical-session.target
